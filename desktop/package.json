{
  "name": "pctra",
  "productName": "PCTRA",
  "version": "1.1.0",
  "description": "PCTRA, l'appli PC de PETRA",
  "author": "MrKazar",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-web": "node prepare-web.mjs",
    "start": "npm run prepare-web && electron .",
    "dist": "npm run prepare-web && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "fr.mrkazar.pctra",
    "productName": "PCTRA",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "server.cjs",
      "backups.cjs",
      "window.cjs",
      "web/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PCTRA-${version}-installation.${ext}",
      "shortcutName": "PCTRA"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MrKazar",
        "repo": "PETRA-JS"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
